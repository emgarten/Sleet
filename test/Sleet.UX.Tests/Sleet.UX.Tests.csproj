<Project>
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory), 'README.md'))\build\test.props" />
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <!--
    Browser tests for the gallery written to index.html. These need Chrome or Edge
    and are run by ux-tests.ps1 and ux-tests.sh, they are not part of Sleet.slnx or
    the default build.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="NuGet.Test.Helpers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sleet.Test.Common\Sleet.Test.Common.csproj" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
