<Project>
  <!-- Build output goes to artifacts/ (bin, obj, publish, nupkgs, TestResults). -->
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(RepoRoot)artifacts</ArtifactsPath>
    <PackageOutputPath>$(ArtifactsPath)\nupkgs\</PackageOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Features>strict</Features>
    <DebugType>embedded</DebugType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <NoWarn>$(NoWarn);CA1051;CA1308;CA2007;CA2211</NoWarn>
    <IsPackable>false</IsPackable>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Version info generated from the latest git tag by build/version.proj, see build.ps1 and build.sh. -->
  <Import Project="$(ArtifactsPath)\obj\git.props" Condition="Exists('$(ArtifactsPath)\obj\git.props')" />

  <PropertyGroup>
    <Version Condition="'$(Version)' == '' AND '$(GitVersion)' != ''">$(GitVersion)</Version>
  </PropertyGroup>
</Project>
