<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Package metadata -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Authors>emgarten</Authors>
    <Copyright>Copyright © $([System.DateTime]::Now.ToString(`yyyy`)) Justin Emgarten</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/emgarten/Sleet</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>nuget nugetserver nugetfeed sleet</PackageTags>
    <RepositoryUrl>https://github.com/emgarten/Sleet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(RepoRoot)build\icons\icon.png" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
</Project>
