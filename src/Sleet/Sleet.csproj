<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <Description>Sleet is a static NuGet package feed generator.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sleet</ToolCommandName>
  </PropertyGroup>

  <!-- Sleet.exe settings, used when publishing the single file exe for the SleetExe package. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="McMaster.Extensions.CommandLineUtils" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SleetLib\SleetLib.csproj" />
  </ItemGroup>

  <!-- SleetExe package settings, used when PackSleetExe packs this project with PackageId=SleetExe. -->
  <PropertyGroup Condition="'$(PackageId)' == 'SleetExe'">
    <PackAsTool>false</PackAsTool>
    <IncludeSymbols>false</IncludeSymbols>
    <NuspecFile>$(MSBuildThisFileDirectory)SleetExe.nuspec</NuspecFile>
    <NuspecProperties>version=$(Version);copyright=$(Copyright);branch=$(RepositoryBranch);commit=$(RepositoryCommit)</NuspecProperties>
  </PropertyGroup>

  <!--
    Pack SleetExe from the single file Sleet.exe published to artifacts/publish.
    Enabled with -p:PackSleetExe=true, see build.ps1.
  -->
  <Target Name="PackSleetExe" AfterTargets="Pack" Condition="'$(PackSleetExe)' == 'true' AND '$(PackageId)' != 'SleetExe'">
    <PropertyGroup>
      <SleetExePath>$(ArtifactsPath)\publish\Sleet.exe</SleetExePath>
    </PropertyGroup>

    <Error Condition="!Exists('$(SleetExePath)')" Text="Missing $(SleetExePath). Publish Sleet.exe before packing SleetExe." />

    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Pack"
             Properties="NoBuild=true;PackSleetExe=false;PackageId=SleetExe" />
  </Target>
</Project>
