<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>SleetExe</id>
    <version>$version$</version>
    <authors>emgarten</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <icon>icon.png</icon>
    <projectUrl>https://github.com/emgarten/Sleet</projectUrl>
    <description>Sleet is a static feed generator for NuGet package feeds. This package contains Sleet.exe, an alternative to the dotnet tool.</description>
    <copyright>$copyright$</copyright>
    <tags>nuget nugetserver nugetfeed sleet</tags>
    <repository type="git" url="https://github.com/emgarten/Sleet" branch="$branch$" commit="$commit$" />
    <developmentDependency>true</developmentDependency>
  </metadata>
  <files>
    <file src="..\..\artifacts\publish\Sleet.exe" target="tools\" />
    <file src="SleetExe.props" target="build\" />
    <file src="..\..\build\icons\icon.png" target="" />
  </files>
</package>
